# Group 13 — Server Log Security Threat Detection
# Source this file:  source config.env   (or: . ./config.env)

export HDFS_ROOT=/data/security
export HDFS_LOGS=${HDFS_ROOT}/logs
export HDFS_PARSED=${HDFS_ROOT}/parsed
export HDFS_AGG=${HDFS_ROOT}/agg/ip_hour
export HDFS_EXPORT=${HDFS_ROOT}/export

# Local path to sample (or generated) day-partitioned logs
export LOCAL_DATA_DIR=./data/sample

# MapReduce
export MR_JAR=./mapreduce/target/suspicious-ip-detection-1.0.jar
export MR_MAIN=edu.bits.bds.security.SuspiciousIpDriver
export THRESHOLD=50

# HBase
export HBASE_TABLE=security_ip_blacklist
export HBASE_TTL_SECONDS=604800

# Hive
export HIVE_DB=security_analytics
